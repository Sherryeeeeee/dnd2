# 只在本机使用；不要提交真实密钥，也不要把密钥写入前端文件。
OPENAI_API_KEY=your_openai_api_key
OPENAI_DM_MODEL=gpt-4o-mini

# 语音默认使用 OpenAI。切换豆包时，填写下列变量并将 TTS_PROVIDER 改为 doubao。
TTS_PROVIDER=openai
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=marin

